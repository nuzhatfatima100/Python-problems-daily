def weakest_strong_link(strength):
--Step 1: Get matrix dimensions
  m=len(strength)
  n=len(strength[0])
  
Step 2: Prepare helper arrays  
  min_row=[0]* m 
  max_col=[0] * n 

Step 3: Compute the minimum of each row  
  for i in range(m):
    min_row[i]=min(strength[i])

Step 4: Compute the maximum of each column
  for j in range(n):
    cur_max=0
    for i in range(m):
      cur_max=max(cur_max,strength[i][j])
    max_col[j]=cur_max
    
Step 5: Look for a cell that satisfies BOTH conditions    
  for i in range(m):
    for j in range(n):
      if strength[i][j]==min_row[i] and strength[i][j]==max_col[j]:
        return strength[i][j]
        
        
  return -1
